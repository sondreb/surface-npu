<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SurfaceAIStudio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="StudioBg">#FF121418</Color>
            <Color x:Key="StudioPanel">#FF1B1E24</Color>
            <Color x:Key="StudioRaised">#FF262A33</Color>
            <Color x:Key="StudioLine">#FF343945</Color>
            <Color x:Key="StudioText">#FFF4F0E8</Color>
            <Color x:Key="StudioMuted">#FFB7B1A6</Color>
            <Color x:Key="StudioAccent">#FFE2A56B</Color>
            <Color x:Key="StudioInk">#FF241C14</Color>

            <SolidColorBrush x:Key="StudioBgBrush" Color="{StaticResource StudioBg}" />
            <SolidColorBrush x:Key="StudioPanelBrush" Color="{StaticResource StudioPanel}" />
            <SolidColorBrush x:Key="StudioRaisedBrush" Color="{StaticResource StudioRaised}" />
            <SolidColorBrush x:Key="StudioLineBrush" Color="{StaticResource StudioLine}" />
            <SolidColorBrush x:Key="StudioTextBrush" Color="{StaticResource StudioText}" />
            <SolidColorBrush x:Key="StudioMutedBrush" Color="{StaticResource StudioMuted}" />
            <SolidColorBrush x:Key="StudioAccentBrush" Color="{StaticResource StudioAccent}" />
            <SolidColorBrush x:Key="StudioInkBrush" Color="{StaticResource StudioInk}" />

            <Style x:Key="ToolButtonStyle" TargetType="RadioButton">
                <Setter Property="MinHeight" Value="62" />
                <Setter Property="Margin" Value="8,3" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{StaticResource StudioMutedBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="Root" Background="Transparent" CornerRadius="10" Padding="4,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#FF262A33" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="#FFE2A56B" />
                                                <Setter Target="Root.(TextBlock.Foreground)" Value="#FF241C14" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Unchecked" />
                                        <VisualState x:Name="Indeterminate" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource StudioRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource StudioTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
                <Setter Property="Background" Value="{StaticResource StudioAccentBrush}" />
                <Setter Property="Foreground" Value="{StaticResource StudioInkBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
